# Laya Environment Variables
# Copy this file to `.env` and fill in your local values.
# Never commit `.env` or any real secrets.

# ── Core Runtime ──────────────────────────────────────────────
# Bearer token required on every request except GET /health.
# Generate one with: openssl rand -hex 32
LAYA_API_KEY=

# Router alias used as the default checkpoint:
# auto | english | multilingual | typed-decisions
LAYA_MODEL=auto

# Container port (Traefik reaches the service on this port inside the network)
LAYA_PORT=8000

# cpu | cuda (cuda needs compose.cuda.yaml from upstream: NVIDIA driver + Container Toolkit)
LAYA_DEVICE=cpu
# NVIDIA device index or UUID when LAYA_DEVICE=cuda
# LAYA_GPU_ID=0

# ── Performance ───────────────────────────────────────────────
# Keep at or below the number of physical cores
OMP_NUM_THREADS=4
# LAYA_THREADS=4

# 1 preloads every checkpoint at startup (first boot downloads them all)
LAYA_PRELOAD=0
# Comma list to preload: english,multilingual,typed-decisions
# LAYA_MODELS=

# ── Checkpoints ───────────────────────────────────────────────
# 1 uses only already-cached checkpoints, no network needed
HF_HUB_OFFLINE=0
# Optional Hugging Face credential for gated repos
# HF_TOKEN=hf_...
# Pin the Hub commit/branch/tag every checkpoint resolves to, or `reviewed`
# LAYA_REVISION=
# Named volume holding the downloaded weights
# LAYA_CACHE_VOLUME=laya_model-cache

# ── Reverse Proxy ─────────────────────────────────────────────
# FastAPI external URL prefix when published under a sub-path (proxy must strip it)
# LAYA_ROOT_PATH=/laya

# ── Build ─────────────────────────────────────────────────────
# PyTorch wheel index: cpu | cu130 (CUDA). Changing either value needs a rebuild.
# LAYA_TORCH_INDEX=cpu
# LAYA_TORCH_VERSION=2.14.0
